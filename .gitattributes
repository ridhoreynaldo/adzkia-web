# Akhiran baris dinormalkan di repositori (LF), apa pun sistem operasi
# penyuntingnya. Tanpa ini, setiap berkas yang disentuh dari Windows tampil
# sebagai "seluruh barisnya berubah" pada diff berikutnya.
* text=auto eol=lf

# Berkas yang HARUS berakhiran LF walau dibuka di Windows: keduanya dijalankan
# di server Linux, dan CRLF membuat shell menolaknya ("bad interpreter").
*.sh   text eol=lf
*.conf text eol=lf
*.ini  text eol=lf

# Skrip PowerShell justru sebaliknya.
*.ps1  text eol=crlf

# Biner - jangan disentuh sama sekali.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.mp3  binary
*.docx binary
*.pdf  binary
