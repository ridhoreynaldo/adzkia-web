# Database SQLite lokal
/data
*.db
*.db-wal
*.db-shm

# Berkas kerja yang dibuat perkakas, seluruhnya di bawah SATU folder.
#
# Pemeriksa `npm run cek:*` menyalin src/lib ke `.tmp/cek/<nama>` sebelum
# menjalankannya. Salinannya harus berada DI DALAM proyek supaya `node_modules`
# tetap terjangkau — itulah sebabnya ia tidak memakai folder sementara milik
# sistem operasi. Yang bisa dilakukan hanyalah menaruhnya di satu tempat,
# bukan berserak sebagai 22 folder `.cek-*` di akar proyek.
.tmp/

# ---- ADZKIA SMART versi PostgreSQL ----
# Sandi sungguhan. Contohnya ada di .env.example.
.env

# Basis data SQLite lama - tidak dipakai lagi di folder ini.
data/*.db
data/*.db-wal
data/*.db-shm

# Berkas yang diunggah pengguna saat aplikasi berjalan.
data/ielts-audio
public/soal
public/peserta
public/warung


# Cermin struktur produksi (data, rahasia, cadangan, log) — lihat scripts/siapkan-struktur.mjs
.lokal/

# Catatan keluaran server saat pengujian lokal.
*.log
userlist.lokal.txt
